{
  "recipes": {
    "type-scale": {
      "description": "Three text layers on a modular scale (headline, subhead, body) stacked from the top margin, with roles set, ready for content.",
      "params": {
        "artboard": {
          "type": "artboard",
          "description": "The artboard"
        },
        "font": {
          "type": "string",
          "description": "Font family (font_list finds installed ones)"
        },
        "base": {
          "type": "number",
          "description": "Body size in px",
          "default": 32
        },
        "ratio": {
          "type": "number",
          "description": "Scale ratio, e.g. 1.25, 1.333, 1.5",
          "default": 1.333
        },
        "color": {
          "type": "color",
          "description": "Text colour",
          "default": "#1C1B19"
        },
        "margin": {
          "type": "number",
          "description": "Side margin as a fraction of the width",
          "default": 0.08
        },
        "top": {
          "type": "number",
          "description": "Top of the headline as a fraction of the height",
          "default": 0.1
        },
        "headline": {
          "type": "string",
          "description": "Headline text",
          "default": "Headline"
        },
        "subhead": {
          "type": "string",
          "description": "Subhead text",
          "default": "A supporting line"
        },
        "body": {
          "type": "string",
          "description": "Body text",
          "default": "Body copy goes here."
        }
      },
      "ops": [
        {
          "op": "insert",
          "into": "#{{artboard}}",
          "layer": {
            "id": "headline",
            "name": "Headline",
            "type": "text",
            "content": "{{headline}}",
            "meta": {
              "role": "headline"
            },
            "style": {
              "font": "{{font}}",
              "size": "{{= round(base * ratio * ratio * ratio)}}",
              "weight": 700,
              "fill": "{{color}}",
              "leading": "{{= round(base * ratio * ratio * ratio * 1.1)}}"
            },
            "frame": {
              "x": "{{= artboard.w * margin}}",
              "y": "{{= artboard.h * top}}",
              "w": "{{= artboard.w * (1 - 2 * margin)}}",
              "h": "{{= round(base * ratio * ratio * ratio * 2.4)}}"
            }
          }
        },
        {
          "op": "insert",
          "into": "#{{artboard}}",
          "layer": {
            "id": "subhead",
            "name": "Subhead",
            "type": "text",
            "content": "{{subhead}}",
            "meta": {
              "role": "body"
            },
            "style": {
              "font": "{{font}}",
              "size": "{{= round(base * ratio)}}",
              "weight": 600,
              "fill": "{{color}}",
              "leading": "{{= round(base * ratio * 1.3)}}"
            },
            "frame": {
              "x": "{{= artboard.w * margin}}",
              "y": "{{= artboard.h * top + round(base * ratio * ratio * ratio * 2.4) + base}}",
              "w": "{{= artboard.w * (1 - 2 * margin)}}",
              "h": "{{= round(base * ratio * 2.8)}}"
            }
          }
        },
        {
          "op": "insert",
          "into": "#{{artboard}}",
          "layer": {
            "id": "body",
            "name": "Body",
            "type": "text",
            "content": "{{body}}",
            "meta": {
              "role": "body"
            },
            "style": {
              "font": "{{font}}",
              "size": "{{base}}",
              "weight": 400,
              "fill": "{{color}}",
              "leading": "{{= round(base * 1.4)}}"
            },
            "frame": {
              "x": "{{= artboard.w * margin}}",
              "y": "{{= artboard.h * top + round(base * ratio * ratio * ratio * 2.4) + base + round(base * ratio * 2.8) + base}}",
              "w": "{{= min(artboard.w * (1 - 2 * margin), base * 22)}}",
              "h": "{{= round(base * 1.4 * 5)}}"
            }
          }
        }
      ]
    }
  }
}
