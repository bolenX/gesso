  { "what": "names, tagline and billing block are the supporting text", "count": { "selector": "@body", "equals": 3 } },
  { "what": "one title", "count": { "selector": "@headline", "equals": 1 } },
  { "what": "the scrim darkens the bottom behind the billing block", "metric": "luminance.mean", "region": [0, 1400, 1000, 80], "less": 0.4 },
  { "what": "the top of the art is left alone", "sample": [500, 300], "size": 5, "deltaE": { "max": 1 } },
  { "what": "nothing too small or off the poster", "preflight": { "maxErrors": 0, "maxWarnings": 0 } }
 ]
