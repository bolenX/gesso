# Settings for hosted Gesso (docs/hosting.md lists them all). Copy to gesso.env and fill in.
# Never commit gesso.env.

GESSO_PUBLIC_URL=https://mcp.gesso.run

# Signs sign-in tokens and links. Make one with `openssl rand -hex 32`, and keep it: changing it signs
# everyone out and gives people who sign in with an account new, empty workspaces.
GESSO_SECRET=

# Optional: "Continue with GitHub". Callback URL: https://mcp.gesso.run/oauth/github/callback
GESSO_GITHUB_CLIENT_ID=
GESSO_GITHUB_CLIENT_SECRET=

# Optional: "Continue with Google". Redirect URI: https://mcp.gesso.run/oauth/google/callback
GESSO_GOOGLE_CLIENT_ID=
GESSO_GOOGLE_CLIENT_SECRET=

# Worker processes for tool calls (defaults to the number of cores, at most 4).
GESSO_WORKERS=2
GESSO_WORKER_MB=1024
